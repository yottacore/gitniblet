#!/usr/bin/env bash

##	Purpose:
##		Lets 'dogfood_gitniblet' be typed at a shell without anyone having to
##		know it is a pwsh script. Hands off to dogfood_gitniblet.ps1 in the same
##		window and passes everything through. The same file goes in the
##		linux/bash and macos/bash util dirs; the .ps1 works out the per-platform
##		paths itself.
##	History: At bottom of script.

