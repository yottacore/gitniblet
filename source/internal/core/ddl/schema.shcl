# The DDL's own vocabulary, as an SHCL schema. shcl's validator checks a DDL
# against this, so every "unknown key" and "value outside its allowed set"
# diagnostic arrives with a line number without this package parsing anything.
#
# A schema path legalizes its own name chain and every prefix, so wrapper
# sections (database:, tables:, fields:) need no entries of their own.
#
# The database: and ui: wrappers are organizational, so the DDL accepts a
# section at either depth. Each such section is a fragment mounted twice - once
# wrapped, once flat - rather than a second copy of its paths.

# -- application-level script hooks --

field: code.before_open
	type: string
	desc: Runs before any UI appears; returning false cancels the open.
field: code.after_open
	type: string
field: code.before_sync
	type: string
field: code.after_sync
	type: string
field: code.before_viewchange
	type: string
field: code.after_viewchange
	type: string
field: code.before_close
	type: string
field: code.after_close
	type: string

# The pre-2026-07 spelling of code:, still accepted.
field: methods.before_open
	type: string
field: methods.after_open
	type: string
field: methods.before_sync
	type: string
field: methods.after_sync
	type: string
field: methods.before_viewchange
	type: string
field: methods.after_viewchange
	type: string
field: methods.before_close
	type: string
field: methods.after_close
	type: string

# -- tunables --

field: tunables.git_sync_frequency
	type: int
	min: 0
	desc: Seconds between automatic git syncs; 0 turns syncing off.
field: tunables.gc_age_days
	type: int
	min: 0
	desc: Age past which a deleted row may be collected from the log.

# -- mounts: each section, wrapped and flat --

field: database.encryption
	type: string
	allowed: always, never, auto
	desc: Locks encryption for every table and field below unless auto.
field: encryption
	type: string
	allowed: always, never, auto

field: database.tables
	inherits: tables
field: tables
	inherits: tables

field: database.relationships
	inherits: relationships
field: relationships
	inherits: relationships

field: database.seed
	inherits: seed
field: seed
	inherits: seed

field: ui.views
	inherits: views
field: views
	inherits: views

field: ui.default_view
	type: string
	desc: View opened at startup; empty means the first view defined.
field: default_view
	type: string

# -- tables --

fragment: tables
	field: "table[*]"
		type: string
		repeat: 0, 4096
		desc: One table. Its value is the table name.
	field: "table[*].aliases"
		type: string-array
		desc: Former names, so a renamed table still replays from the log.
	field: "table[*].system_fields"
		type: bool
		desc: Set no to drop the auto-added is_active/date_created/is_deleted.
	field: "table[*].encryption"
		type: string
		allowed: always, never, auto

	field: "table[*].access.read.whitelist"
		type: string-array
	field: "table[*].access.read.blacklist"
		type: string-array
	field: "table[*].access.read.blaclist"
		type: string-array
		desc: Misspelling the original example DDL carried; still read.
	field: "table[*].access.write.whitelist"
		type: string-array
	field: "table[*].access.write.blacklist"
		type: string-array
	field: "table[*].access.delete.whitelist"
		type: string-array
	field: "table[*].access.delete.blacklist"
		type: string-array

	field: "table[*].code.before_update"
		type: string
	field: "table[*].code.after_update"
		type: string
	field: "table[*].methods.before_update"
		type: string
	field: "table[*].methods.after_update"
		type: string

	field: "table[*].uniques.unique[*]"
		type: string-array
		repeat: 0, 4096
		desc: One unique group, as a comma list of field names. Also indexed.
	field: "table[*].indexes.index[*]"
		type: string-array
		repeat: 0, 4096
		desc: One index, as a comma list of field names.

	field: "table[*].features.local_attachments"
		type: bool
	field: "table[*].features.uri_attachments"
		type: bool
	field: "table[*].features.comments"
		type: bool
	field: "table[*].features.audit_trail"
		type: bool
	field: "table[*].features.row_level_access"
		type: bool

	# -- fields --

	field: "table[*].fields.field[*]"
		type: string
		repeat: 0, 4096
		desc: One column. Its value is the field name.
	field: "table[*].fields.field[*].aliases"
		type: string-array
	field: "table[*].fields.field[*].type"
		type: string
		allowed: string, int, float, bool, datetime, datetime_local, datetime_utc, binary, ref
		desc: Column type. ref holds another row's id as raw bytes.
	field: "table[*].fields.field[*].encryption"
		type: string
		allowed: always, never, auto
	field: "table[*].fields.field[*].special"
		type: string
		desc: Percent or currency handling for display and storage.
	field: "table[*].fields.field[*].is_active"
		type: bool
	field: "table[*].fields.field[*].defaultval"
		desc: A literal, the sentinel @null or @previous, or a fFunction() name.
	field: "table[*].fields.field[*].null_ok"
		type: bool
	field: "table[*].fields.field[*].empty_ok"
		type: bool

	field: "table[*].fields.field[*].access.read.whitelist"
		type: string-array
	field: "table[*].fields.field[*].access.read.blacklist"
		type: string-array
	field: "table[*].fields.field[*].access.write.whitelist"
		type: string-array
	field: "table[*].fields.field[*].access.write.blacklist"
		type: string-array

	field: "table[*].fields.field[*].validation.null_ok"
		type: bool
	field: "table[*].fields.field[*].validation.empty_ok"
		type: bool
	field: "table[*].fields.field[*].validation.required"
		type: bool
	field: "table[*].fields.field[*].validation.minlen"
		type: int
		min: 0
	field: "table[*].fields.field[*].validation.maxlen"
		type: int
		min: 0
	field: "table[*].fields.field[*].validation.minval"
		type: float
	field: "table[*].fields.field[*].validation.maxval"
		type: float
	field: "table[*].fields.field[*].validation.regex"
		desc: Untyped: a regex is read verbatim, so commas stay content.
	field: "table[*].fields.field[*].validation.method"
		type: string
	field: "table[*].fields.field[*].validation.defaultval"

	field: "table[*].fields.field[*].code.before_update"
		type: string
	field: "table[*].fields.field[*].code.after_update"
		type: string
	field: "table[*].fields.field[*].methods.before_update"
		type: string
	field: "table[*].fields.field[*].methods.after_update"
		type: string

	field: "table[*].fields.field[*].ui.visible_form"
		type: bool
	field: "table[*].fields.field[*].ui.visible_list"
		type: bool
	field: "table[*].fields.field[*].ui.label"
		type: string
	field: "table[*].fields.field[*].ui.title"
		type: string
		desc: Earlier spelling of label.
	field: "table[*].fields.field[*].ui.description"
		type: string
	field: "table[*].fields.field[*].ui.order"
		type: float
		desc: Display and tab order.
	field: "table[*].fields.field[*].ui.readonly"
		type: bool
	field: "table[*].fields.field[*].ui.width"
		type: int
		min: 0
	field: "table[*].fields.field[*].ui.widget"
		type: string
		allowed: listbox, editbox, radio, checkbox, image, audio
	field: "table[*].fields.field[*].ui.format"
		type: string
	field: "table[*].fields.field[*].ui.list_type"
		type: string
		allowed: literal, sql, lookup
	field: "table[*].fields.field[*].ui.list_source"
		desc: Untyped: holds literals, a SQL block, or a lookups idx.
	field: "table[*].fields.field[*].ui.lookup_in_lists"
		type: string
		allowed: symbol, title, both
	field: "table[*].fields.field[*].ui.lookup_in_forms"
		type: string
		allowed: symbol, title, both

# -- relationships --

fragment: relationships
	field: "relationship[*]"
		repeat: 0, 4096
		desc: One relationship. Named, so two unnamed ones cannot merge.
	field: "relationship[*].type"
		type: string
		allowed: 1:m, m:m
	field: "relationship[*].parent"
		type: string
	field: "relationship[*].child"
		type: string
	field: "relationship[*].parent_id_field"
		type: string
		desc: The child field holding the parent id; it gets indexed.
	field: "relationship[*].cascade_delete"
		type: bool
	field: "relationship[*].enable_audit_trail"
		type: bool

# -- seed rows --
# A seeded table is an instance, not a field name, so an arbitrary table name
# stays validatable. Rows apply log-first at open when absent and never
# overwrite: a later runtime edit wins for good.

fragment: seed
	field: "table[*]"
		type: string
		repeat: 0, 4096
		desc: One seeded table. Its value is the table name.
	field: "table[*].row[*]"
		type: string-array
		repeat: 0, 4096
		desc: One row, as a comma list of field=value pairs.

# -- views --

fragment: views
	field: "view[*]"
		type: string
		repeat: 0, 4096
		desc: One view. Its value is the view name.
	field: "view[*].aliases"
		type: string-array
	field: "view[*].startup_named_query"
		type: string
		desc: Named query whose dataset loads when the view opens.
	field: "view[*].default_named_query"
		type: string
		desc: Pre-rename spelling of startup_named_query.
	field: "view[*].readonly"
		type: bool
	field: "view[*].access.whitelist"
		type: string-array
	field: "view[*].access.blacklist"
		type: string-array
	field: "view[*].layout"
		inherits: layout

# -- layout blocks --
# A block holds blocks, so the shape mounts itself. Validation follows a mount
# only where the document has nodes, so nesting is unlimited and costs nothing
# at rest.

fragment: layout
	field: "block[*]"
		type: string
		repeat: 0, 4096
		inherits: layout
		desc: One layout block. Nests to any depth.
	field: "block[*].table"
		type: string
	field: "block[*].type"
		type: string
		allowed: form, grid, tree_grid, comments
	field: "block[*].parent_field"
		type: string
	field: "block[*].location"
		type: string-array
	field: "block[*].readonly"
		type: bool
